---
import Base from '../layouts/Base.astro';
import modelsData from '../data/models.json';
import { serializeForClient } from '../lib/ranks';
import type { Model } from '../types';

const models = modelsData.models as Model[];
const fetchedAt = new Date(modelsData.fetchedAt).toLocaleString('id-ID', {
  dateStyle: 'long',
  timeStyle: 'short',
});
const freeCount = models.filter((m) => m.isFree).length;
const withRank = models.filter((m) => m.rank.aaIntelligence != null).length;

const serializable = models.map(serializeForClient);
---

<Base title="Daftar Model AI - Cari Terbaik & Termurah">
  <section class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Cari model AI yang <span class="text-accent">terbaik</span> & <span class="text-accent">termurah</span>
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      {models.length} model dari OpenRouter, {freeCount} gratis, {withRank} punya skor ranking.
      Diperbarui {fetchedAt}.
    </p>
  </section>

  <section
    id="filters"
    class="sticky top-0 z-10 -mx-4 mb-6 border-b border-border bg-background/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6"
  >
    <div class="flex flex-wrap items-center gap-2">
      <input
        id="q"
        type="search"
        placeholder="Cari model…"
        class="w-full rounded-md border border-border bg-card px-3 py-1.5 text-sm placeholder:text-muted focus:border-accent focus:outline-none sm:w-64"
      />
      <select id="sort" class="rounded-md border border-border bg-card px-2 py-1.5 text-sm focus:border-accent focus:outline-none">
        <option value="top">Top Models</option>
        <option value="weekly">Weekly Usage</option>
        <option value="leaderboard">LLM Leaderboard</option>
        <option value="cheapest">Harga termurah</option>
        <option value="newest">Terbaru</option>
        <option value="context">Context terbesar</option>
        <option value="name">Nama A-Z</option>
      </select>
      <label class="flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1.5 text-sm">
        <input id="f-free" type="checkbox" class="accent-emerald-500" /> Gratis
      </label>
      <label class="flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1.5 text-sm">
        <input id="f-vision" type="checkbox" class="accent-emerald-500" /> Vision
      </label>
      <label class="flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1.5 text-sm">
        <input id="f-tools" type="checkbox" class="accent-emerald-500" /> Tools
      </label>
      <span id="count" class="ml-auto text-xs text-muted"></span>
    </div>
  </section>

  <div id="grid" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>

  <div id="empty" class="hidden rounded-xl border border-dashed border-border p-8 text-center text-sm text-muted">
    Tidak ada model yang cocok.
  </div>

  <script type="application/json" id="models-data" set:html={JSON.stringify(serializable)}></script>

  <script is:inline>
    (function () {
      const data = JSON.parse(document.getElementById('models-data').textContent);
      const grid = document.getElementById('grid');
      const empty = document.getElementById('empty');
      const count = document.getElementById('count');
      const q = document.getElementById('q');
      const sort = document.getElementById('sort');
      const fFree = document.getElementById('f-free');
      const fVision = document.getElementById('f-vision');
      const fTools = document.getElementById('f-tools');

      function avg(p) { return (p.prompt + p.completion) / 2; }
      function escape(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
      }
      function fmt(n) {
        if (!isFinite(n) || n === 0) return '0';
        if (n < 0.01) return n.toFixed(4);
        if (n < 1) return n.toFixed(3);
        return n.toFixed(2);
      }
      function rankLabel(s) {
        if (s === 'top') return 'Top';
        if (s === 'weekly') return 'Weekly';
        if (s === 'leaderboard') return 'Leader';
        return '';
      }

      function apply() {
        const term = (q.value || '').trim().toLowerCase();
        let list = data.filter(function (p) {
          if (term && !(p.name.toLowerCase().includes(term) || p.id.toLowerCase().includes(term))) return false;
          if (fFree.checked && !p.isFree) return false;
          if (fVision.checked && !p.vision) return false;
          if (fTools.checked && !p.tools) return false;
          return true;
        });

        const s = sort.value;
        list.sort(function (a, b) {
          if (s === 'cheapest') {
            if (a.isFree !== b.isFree) return a.isFree ? -1 : 1;
            return avg(a) - avg(b);
          }
          if (s === 'newest') return b.created - a.created;
          if (s === 'context') return b.context - a.context;
          if (s === 'name') return a.name.localeCompare(b.name);
          if (s === 'top') return (b.rankTop || 0) - (a.rankTop || 0);
          if (s === 'weekly') return (b.rankWeekly || 0) - (a.rankWeekly || 0);
          if (s === 'leaderboard') return (b.rankLeaderboard || 0) - (a.rankLeaderboard || 0);
          return 0;
        });

        const html = list
          .map(function (p, i) {
            const rank = i + 1;
            const prompt = p.prompt * 1e6;
            const completion = p.completion * 1e6;
            const tag = p.isFree
              ? '<span class="rounded-full bg-accent/15 px-2 py-0.5 text-xs font-medium text-accent">GRATIS</span>'
              : '<span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted">Berbayar</span>';
            const tags = [];
            if (p.vision) tags.push('<span class="rounded-md border border-border px-1.5 py-0.5 text-[10px] text-muted">vision</span>');
            if (p.tools) tags.push('<span class="rounded-md border border-border px-1.5 py-0.5 text-[10px] text-muted">tools</span>');
            const showRankPanel = ['top', 'weekly', 'leaderboard'].includes(s);
            const rankPanel = showRankPanel
              ? '<div class="mt-3 flex items-center gap-3 rounded-md border border-border/60 bg-background/50 px-2 py-1.5 text-xs">' +
                  '<div><div class="text-[10px] uppercase tracking-wide text-muted">' + rankLabel(s) + '</div>' +
                  '<div class="font-mono text-sm font-semibold text-accent">#' + rank + '</div></div>' +
                  '<div class="ml-auto flex gap-3 text-[10px] text-muted">' +
                    (p.aaIntelligence != null ? '<span>AI <span class="font-mono text-foreground/80">' + p.aaIntelligence + '</span></span>' : '') +
                    (p.arenaElo != null ? '<span>Elo <span class="font-mono text-foreground/80">' + Math.round(p.arenaElo) + '</span></span>' : '') +
                  '</div>' +
                '</div>'
              : '';
            return (
              '<article class="group rounded-xl border border-border bg-card p-4 transition hover:border-accent/50">' +
                '<div class="flex items-start justify-between gap-3">' +
                  '<div class="min-w-0 flex-1">' +
                    '<div class="flex items-center gap-2">' +
                      '<span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-background text-xs font-mono text-muted">' + rank + '</span>' +
                      '<a href="/model/' + p.slug + '" class="truncate font-medium hover:text-accent" title="' + escape(p.id) + '">' + escape(p.name) + '</a>' +
                    '</div>' +
                    '<button type="button" class="kodename mt-1 flex w-full max-w-full items-center gap-1 rounded font-mono text-[11px] text-muted transition hover:text-accent" data-copy="' + escape(p.id) + '" title="Klik untuk menyalin">' +
                      '<span class="truncate">' + escape(p.id) + '</span>' +
                      '<svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
                      '<span class="copy-hint hidden text-[10px] text-accent">tersalin ✓</span>' +
                    '</button>' +
                  '</div>' +
                  '<div class="flex shrink-0 flex-col items-end gap-1">' + tag +
                    '<span class="text-[10px] uppercase tracking-wide text-muted">' + p.provider + '</span>' +
                  '</div>' +
                '</div>' +
                rankPanel +
                '<div class="mt-4 grid grid-cols-2 gap-3 text-xs sm:grid-cols-3">' +
                  '<div><div class="text-muted">Input / 1M</div><div class="font-mono">$' + fmt(prompt) + '</div></div>' +
                  '<div><div class="text-muted">Output / 1M</div><div class="font-mono">$' + fmt(completion) + '</div></div>' +
                  '<div><div class="text-muted">Context</div><div class="font-mono">' + p.context.toLocaleString('id-ID') + '</div></div>' +
                '</div>' +
                (tags.length ? '<div class="mt-3 flex flex-wrap gap-1.5">' + tags.join('') + '</div>' : '') +
              '</article>'
            );
          })
          .join('');

        grid.innerHTML = html;
        empty.classList.toggle('hidden', list.length > 0);
        count.textContent = list.length + ' model';

        // re-bind copy buttons
        grid.querySelectorAll('.kodename').forEach(function (el) {
          if (el.dataset.bound) return;
          el.dataset.bound = '1';
          el.addEventListener('click', function (e) {
            e.preventDefault();
            const text = el.getAttribute('data-copy');
            if (!text) return;
            navigator.clipboard?.writeText(text).then(function () {
              const hint = el.querySelector('.copy-hint');
              if (hint) {
                hint.classList.remove('hidden');
                setTimeout(function () { hint.classList.add('hidden'); }, 1200);
              }
            });
          });
        });
      }

      [q, sort, fFree, fVision, fTools].forEach(function (el) {
        el.addEventListener('input', apply);
        el.addEventListener('change', apply);
      });
      apply();
    })();
  </script>
</Base>