---
import Base from '../layouts/Base.astro';
import modelsData from '../data/models.json';
import { serializeForClient } from '../lib/ranks';
import type { Model } from '../types';

const models = modelsData.models as Model[];
const fetchedAt = new Date(modelsData.fetchedAt).toLocaleString('id-ID', {
  dateStyle: 'long',
  timeStyle: 'short',
});
const freeCount = models.filter((m) => m.isFree).length;
const withRank = models.filter((m) => m.rank.aaIntelligence != null).length;

const serializable = models.map(serializeForClient);
---

<Base title="Model AI Terbaik & Termurah">
  <section class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      Cari model AI yang <span class="text-accent">terbaik</span> & <span class="text-accent">termurah</span>
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      {models.length} model dari OpenRouter, {freeCount} gratis, {withRank} punya skor ranking.
      Diperbarui {fetchedAt}.
    </p>
  </section>

  <section
    id="filters"
    class="sticky top-0 z-10 -mx-4 mb-6 border-b border-border bg-background/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6"
  >
    <div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex rounded-md border border-border bg-card p-0.5 text-xs">
        <button
          type="button"
          data-scope="all"
          class="scope-btn rounded px-2 py-1 font-medium transition"
        >Semua</button>
        <button
          type="button"
          data-scope="free"
          class="scope-btn rounded px-2 py-1 font-medium transition"
        >Gratis saja</button>
      </div>
      <input
        id="q"
        type="search"
        placeholder="Cari model…"
        class="w-full rounded-md border border-border bg-card px-3 py-1.5 text-sm placeholder:text-muted focus:border-accent focus:outline-none sm:w-64"
      />
      <select id="sort" class="rounded-md border border-border bg-card px-2 py-1.5 text-sm focus:border-accent focus:outline-none">
        <option value="top">Top Models</option>
        <option value="weekly">Weekly Usage</option>
        <option value="leaderboard">LLM Leaderboard</option>
        <option value="cheapest">Harga termurah</option>
        <option value="newest">Terbaru</option>
        <option value="context">Context terbesar</option>
        <option value="name">Nama A-Z</option>
      </select>
      <select id="task" class="rounded-md border border-border bg-card px-2 py-1.5 text-sm focus:border-accent focus:outline-none">
        <option value="all">Task: Semua</option>
        <option value="coding">Task: Coding</option>
        <option value="math">Task: Math</option>
        <option value="reasoning">Task: Reasoning</option>
        <option value="instruction">Task: Instruction</option>
        <option value="vision">Task: Vision</option>
        <option value="chat">Task: Chat</option>
      </select>
      <label class="flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1.5 text-sm">
        <input id="f-vision" type="checkbox" class="accent-emerald-500" /> Vision
      </label>
      <label class="flex items-center gap-1.5 rounded-md border border-border bg-card px-2 py-1.5 text-sm">
        <input id="f-tools" type="checkbox" class="accent-emerald-500" /> Tools
      </label>
      <span id="count" class="ml-auto text-xs text-muted"></span>
    </div>
  </section>

  <div id="grid" class="grid grid-cols-1 gap-3"></div>

  <div id="empty" class="hidden rounded-xl border border-dashed border-border p-8 text-center text-sm text-muted">
    Tidak ada model yang cocok.
  </div>

  <script type="application/json" id="models-data" set:html={JSON.stringify(serializable)}></script>

  <script is:inline>
    (function () {
      const data = JSON.parse(document.getElementById('models-data').textContent);
      const grid = document.getElementById('grid');
      const empty = document.getElementById('empty');
      const count = document.getElementById('count');
      const q = document.getElementById('q');
      const sort = document.getElementById('sort');
      const task = document.getElementById('task');
      const fVision = document.getElementById('f-vision');
      const fTools = document.getElementById('f-tools');
      const scopeBtns = document.querySelectorAll('.scope-btn');
      let scope = 'all';

      function avg(p) { return (p.prompt + p.completion) / 2; }
      function escape(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
      }
      function fmt(n) {
        if (!isFinite(n) || n === 0) return '0';
        if (n < 0.01) return n.toFixed(4);
        if (n < 1) return n.toFixed(3);
        return n.toFixed(2);
      }
      function rankLabel(s) {
        if (s === 'top') return 'Top';
        if (s === 'weekly') return 'Weekly';
        if (s === 'leaderboard') return 'Leader';
        return '';
      }

      function applyScope() {
        scopeBtns.forEach(function (b) {
          const on = b.getAttribute('data-scope') === scope;
          b.classList.toggle('bg-accent', on);
          b.classList.toggle('text-accent-fg', on);
          b.classList.toggle('text-muted', !on);
        });
      }

      function apply() {
        const term = (q.value || '').trim().toLowerCase();
        const tk = task.value;
        const s = sort.value;
        const isTaskFiltered = tk !== 'all';
        const activeSort = isTaskFiltered ? tk : s;

        let list = data.filter(function (p) {
          if (scope === 'free' && !p.isFree) return false;
          if (term && !(p.name.toLowerCase().includes(term) || p.id.toLowerCase().includes(term))) return false;
          if (fVision.checked && !p.vision) return false;
          if (fTools.checked && !p.tools) return false;
          if (tk === 'coding' && !(p.aiderPassRate2 != null || (p.aaCoding != null && p.aaCoding > 20) || p.rankCoding > 0)) return false;
          if (tk === 'math' && (p.math == null || p.math <= 0)) return false;
          if (tk === 'reasoning' && !(p.bbh != null || p.gpqa != null || p.musr != null || (p.aaAgentic != null && p.aaAgentic > 20) || p.rankReasoning > 0)) return false;
          if (tk === 'instruction' && (p.ifeval == null || p.ifeval <= 0)) return false;
          if (tk === 'vision' && !p.vision) return false;
          if (tk === 'chat' && !p.isFree && !p.tools && (p.aaIntelligence == null || p.aaIntelligence < 20)) return false;
          return true;
        });

        function getSortScore(p) {
          switch (activeSort) {
            case 'top': return p.rankTop || 0;
            case 'weekly': return p.rankWeekly || 0;
            case 'leaderboard': return p.rankLeaderboard || 0;
            case 'cheapest': return p.isFree ? -1 : ((p.prompt + p.completion) / 2);
            case 'newest': return p.created || 0;
            case 'context': return p.context || 0;
            case 'name': return 0;
            case 'coding': return p.aiderPassRate2 ?? p.rankCoding ?? 0;
            case 'math': return p.math ?? p.rankMath ?? 0;
            case 'reasoning': return Math.max(p.bbh || 0, p.gpqa || 0, p.musr || 0) || p.rankReasoning || 0;
            case 'instruction': return p.ifeval ?? p.rankInstruction ?? 0;
            case 'vision': return p.rankVision || 0;
            case 'chat': return p.rankChat || p.aaIntelligence || 0;
            default: return 0;
          }
        }

        if (activeSort === 'name') {
          list.sort((a, b) => a.name.localeCompare(b.name));
        } else if (activeSort === 'cheapest') {
          if (list.every((x) => x.isFree)) {
            list.sort((a, b) => (b.rankTop || 0) - (a.rankTop || 0));
          } else {
            list.sort(function (a, b) {
              if (a.isFree !== b.isFree) return a.isFree ? -1 : 1;
              return ((a.prompt + a.completion) / 2) - ((b.prompt + b.completion) / 2);
            });
          }
        } else {
          list.sort(function (a, b) {
            const sa = getSortScore(a);
            const sb = getSortScore(b);
            if (sb !== sa) return sb - sa;
            return (b.aaIntelligence || 0) - (a.aaIntelligence || 0);
          });
        }

        function taskBadgeHTML(p) {
          if (tk === 'all') return '';
          const map = {
            coding: { v: p.aiderPassRate2 ?? p.aaCoding, label: p.aiderPassRate2 != null ? 'Aider' : 'Coding' },
            math: { v: p.math, label: 'MATH' },
            reasoning: { v: Math.max(p.bbh || 0, p.gpqa || 0, p.musr || 0), label: 'BBH' },
            instruction: { v: p.ifeval, label: 'IFEval' },
            vision: { v: p.rankVision, label: 'Arena' },
            chat: { v: p.aaIntelligence, label: 'AI' },
          };
          const m = map[tk];
          if (!m || m.v == null || m.v === 0) return '';
          return '<span class="rounded-md bg-accent/15 px-1.5 py-0.5 text-[10px] font-mono text-accent">' + m.label + ' ' + (typeof m.v === 'number' ? m.v.toFixed(1) : m.v) + '</span>';
        }

        const html = list
          .map(function (p, i) {
            const rank = i + 1;
            const prompt = p.prompt * 1e6;
            const completion = p.completion * 1e6;
            const tag = p.isFree
              ? '<span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] font-medium text-accent sm:text-xs">GRATIS</span>'
              : '<span class="rounded-full border border-border px-2 py-0.5 text-[10px] text-muted sm:text-xs">Berbayar</span>';
            const tags = [];
            if (p.vision) tags.push('vision');
            if (p.tools) tags.push('tools');
            const taskBadge = taskBadgeHTML(p);
            const allBadges = [...tags, taskBadge].filter(Boolean);
            const tagsMobile = allBadges.map(function (t) { return '<span class="rounded-md border border-border px-1.5 py-0.5 text-[10px] text-muted">' + t + '</span>'; }).join('');
            const tagsDesktop = allBadges.map(function (t) { return '<span class="rounded-md border border-border px-1.5 py-0.5 text-[10px] text-muted">' + t + '</span>'; }).join('');
            const showRankPanel = !isTaskFiltered && ['top', 'weekly', 'leaderboard'].includes(s);
            const rankPanel = showRankPanel
              ? '<div class="flex items-center gap-3 rounded-md border border-border/60 bg-background/50 px-2 py-1">' +
                  '<div><div class="text-[10px] uppercase tracking-wide text-muted">' + rankLabel(s) + '</div>' +
                  '<div class="font-mono text-sm font-semibold text-accent">#' + rank + '</div></div>' +
                  '<div class="ml-auto flex gap-3 text-[10px] text-muted">' +
                    (p.aaIntelligence != null ? '<span>AI <span class="font-mono text-foreground/80">' + p.aaIntelligence + '</span></span>' : '') +
                    (p.arenaElo != null ? '<span>Elo <span class="font-mono text-foreground/80">' + Math.round(p.arenaElo) + '</span></span>' : '') +
                  '</div>' +
                '</div>'
              : '<div class="flex gap-3 text-[10px] text-muted">' +
                  (p.aaIntelligence != null ? '<span>AI <span class="font-mono text-foreground/80">' + p.aaIntelligence + '</span></span>' : '') +
                  (p.arenaElo != null ? '<span>Elo <span class="font-mono text-foreground/80">' + Math.round(p.arenaElo) + '</span></span>' : '') +
                '</div>';
            return (
              '<article class="group rounded-xl border border-border bg-card p-4 transition hover:border-accent/50 sm:p-3">' +
                '<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">' +
                  '<div class="flex items-start gap-3 sm:flex-1 sm:items-center">' +
                    '<span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-background text-sm font-mono text-muted">' + rank + '</span>' +
                    '<div class="min-w-0 flex-1">' +
                      '<div class="flex flex-wrap items-center gap-2">' +
                        '<a href="/model/' + p.slug + '" class="truncate font-medium hover:text-accent" title="' + escape(p.id) + '">' + escape(p.name) + '</a>' + tag +
                        '<span class="hidden rounded-md border border-border px-1.5 py-0.5 text-[10px] uppercase tracking-wide text-muted sm:inline">' + p.provider + '</span>' +
                      '</div>' +
                      '<button type="button" class="kodename mt-1 flex w-full max-w-full items-center gap-1 rounded font-mono text-[11px] text-muted transition hover:text-accent" data-copy="' + escape(p.id) + '" title="Klik untuk menyalin">' +
                        '<span class="truncate">' + escape(p.id) + '</span>' +
                        '<svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
                        '<span class="copy-hint hidden text-[10px] text-accent">tersalin ✓</span>' +
                      '</button>' +
                      (allBadges.length ? '<div class="mt-1.5 flex flex-wrap gap-1.5 sm:hidden">' + tagsMobile + '</div>' : '') +
                    '</div>' +
                  '</div>' +
                  '<div class="hidden flex-col items-end text-xs sm:flex sm:w-56">' + rankPanel + '</div>' +
                  '<div class="grid grid-cols-3 gap-3 text-xs sm:flex sm:w-72 sm:gap-4 sm:border-l sm:border-border/60 sm:pl-4">' +
                    '<div><div class="text-[10px] uppercase tracking-wide text-muted sm:text-xs">Input / 1M</div><div class="font-mono">$' + fmt(prompt) + '</div></div>' +
                    '<div><div class="text-[10px] uppercase tracking-wide text-muted sm:text-xs">Output / 1M</div><div class="font-mono">$' + fmt(completion) + '</div></div>' +
                    '<div><div class="text-[10px] uppercase tracking-wide text-muted sm:text-xs">Context</div><div class="font-mono">' + p.context.toLocaleString('id-ID') + '</div></div>' +
                  '</div>' +
                  (allBadges.length ? '<div class="hidden flex-wrap justify-end gap-1.5 sm:flex sm:w-32">' + tagsDesktop + '</div>' : '<div class="hidden sm:block sm:w-32"></div>') +
                '</div>' +
              '</article>'
            );
          })
          .join('');

        grid.innerHTML = html;
        empty.classList.toggle('hidden', list.length > 0);
        count.textContent = list.length + ' model';

        grid.querySelectorAll('.kodename').forEach(function (el) {
          if (el.dataset.bound) return;
          el.dataset.bound = '1';
          el.addEventListener('click', function (e) {
            e.preventDefault();
            const text = el.getAttribute('data-copy');
            if (!text) return;
            navigator.clipboard?.writeText(text).then(function () {
              const hint = el.querySelector('.copy-hint');
              if (hint) {
                hint.classList.remove('hidden');
                setTimeout(function () { hint.classList.add('hidden'); }, 1200);
              }
            });
          });
        });
      }

      scopeBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          scope = b.getAttribute('data-scope');
          applyScope();
          apply();
        });
      });
      [q, sort, task, fVision, fTools].forEach(function (el) {
        el.addEventListener('input', apply);
        el.addEventListener('change', apply);
      });
      applyScope();
      apply();
    })();
  </script>
</Base>