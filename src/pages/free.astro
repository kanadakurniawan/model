---
import Base from '../layouts/Base.astro';
import ModelCard from '../components/ModelCard.astro';
import modelsData from '../data/models.json';
import { rankModels } from '../lib/ranks';
import type { Model } from '../types';

const models = modelsData.models as Model[];
const ranked = rankModels(models, 'top', (m) => m.isFree);
---

<Base title="Model AI Gratis - model.kanadakurniwan">
  <section class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Model <span class="text-accent">gratis</span></h1>
    <p class="mt-2 text-sm text-muted">
      {models.filter((m) => m.isFree).length} model gratis, diurutkan dari ranking Top Models
      (gabungan ELO + Intelligence Index + Context + Capability). Model berbayar disembunyikan.
    </p>
  </section>
  <div class="grid grid-cols-1 gap-3">
    {ranked.map((e) => (
      <ModelCard model={e.model} rank={e.rank} showRank rankLabel="Top Rank" rankValue={e.rank} />
    ))}
  </div>
</Base>