---
import Base from '../layouts/Base.astro';
import ModelCard from '../components/ModelCard.astro';
import modelsData from '../data/models.json';
import type { Model } from '../types';

const models = (modelsData.models as Model[]).filter((m) => m.isFree);
---

<Base title="Model AI Gratis - model.kanadakurniwan">
  <section class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Model <span class="text-accent">gratis</span></h1>
    <p class="mt-2 text-sm text-muted">{models.length} model dengan harga input & output $0 per 1M token.</p>
  </section>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {models.map((m, i) => <ModelCard model={m} rank={i + 1} />)}
  </div>
</Base>
